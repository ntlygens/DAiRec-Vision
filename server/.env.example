# Copy this file to .env and fill in real values. .env is git-ignored.
# MongoDB Atlas (SRV) connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Content API port and listen address (defaults shown). Keep HOST private.
PORT=5200
HOST=127.0.0.1

# Optional. Set to a long random value to allow POST/PUT/DELETE with header x-api-key.
# Leave unset in production to keep the API read-only (copy scripts write to MongoDB directly).
# ADMIN_API_KEY=

# Page server (client) setting, set where the Angular server runs:
# API_ORIGIN=http://127.0.0.1:5200
