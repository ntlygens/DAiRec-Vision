{
  // DaiRec Vision: Angular SSR + content API on Cloudflare Workers, content in D1.
  // Production (main branch):  npm run deploy           -> dairecvision.com
  // Preview (staging branch):  npm run deploy:staging   -> dairec-vision-staging.ntlygens.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dairec-vision",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client/browser",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dairec-content",
      // Created 2026-11-09 (region: eastern North America)
      "database_id": "b0b98394-ffc0-4a43-9386-a1a7b0e8ab0f",
      // Local dev (wrangler dev / npm run preview) reads the real Cloudflare database, read-only API.
      "remote": true
    }
  ],
  "routes": [
    { "pattern": "dairecvision.com", "custom_domain": true },
    { "pattern": "www.dairecvision.com", "custom_domain": true }
  ],
  // Deployment id, used to key the page cache so each deploy serves fresh pages.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "env": {
    // Preview environment for the staging branch: same content database, workers.dev address only.
    "staging": {
      "name": "dairec-vision-staging",
      "routes": [],
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "dairec-content", "database_id": "b0b98394-ffc0-4a43-9386-a1a7b0e8ab0f", "remote": true }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" }
    }
  }
}
